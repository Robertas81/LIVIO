{
  "name": "Comment",
  "type": "object",
  "properties": {
    "photo_id": {
      "type": "string",
      "description": "Reference to the SitePhoto id"
    },
    "text": {
      "type": "string",
      "description": "Comment text"
    }
  },
  "required": [
    "photo_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}